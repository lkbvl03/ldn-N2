{
  "name": "it-happened-weird-template",
  "version": "1.0.0",
  "description": "Template Remotion 3D Sketch Infographic Motion — short-form science video",
  "main": "index.js",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render src/index.ts MyVideo out/video.mp4 --codec=h264 --crf=18",
    "voice": "python -X utf8 scripts/step1_voice.py",
    "music": "python -X utf8 scripts/generate_audio.py",
    "sfx": "python -X utf8 scripts/generate_sfx2.py",
    "background": "python -X utf8 scripts/gen_background.py",
    "pipeline": "npm run voice && npm run music && npm run sfx && npm run background",
    "full": "npm run pipeline && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "remotion": {
    "entrypoint": "src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.469",
    "@remotion/media-utils": "4.0.469",
    "@remotion/player": "^4.0.469",
    "@remotion/renderer": "^4.0.469",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "^4.0.469",
    "typescript": "^6.0.3"
  }
}
